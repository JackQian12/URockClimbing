.page-header{padding:24rpx 4rpx 34rpx;font-size:48rpx;font-weight:800}.state-card{display:flex;min-height:280rpx;align-items:center;justify-content:center}.error-text{color:#a1443c}.record{display:flex;justify-content:space-between;padding:28rpx 0;border-bottom:1rpx solid #eee8df}.record view{display:flex;flex-direction:column;gap:7rpx}.record view text:not(:first-child){color:#9a918a;font-size:20rpx}.record>text{font-weight:700}
