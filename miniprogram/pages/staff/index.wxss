.staff-hero{padding:38rpx;border-radius:28rpx;color:#fff;background:linear-gradient(135deg,#4c2716,#8a4525)}.staff-hero>text{display:block}.staff-hero>text:first-child{font-size:40rpx;font-weight:800}.staff-hero>text:nth-child(2){margin-top:12rpx;color:rgba(255,255,255,.75);font-size:24rpx}.staff-hero button{margin-top:36rpx;color:#542b15;background:#fff;font-weight:800}.section-title{display:flex;justify-content:space-between;margin:42rpx 4rpx 20rpx;font-size:30rpx;font-weight:800}.section-title text:last-child{color:#8a5a38;font-size:24rpx}.state-card{display:flex;min-height:220rpx;align-items:center;justify-content:center}.error-text{color:#a1443c}.record{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:26rpx 0;border-bottom:1rpx solid #eee8df}.record view{display:flex;flex-direction:column;gap:8rpx}.record view text:first-child{font-weight:700}.record view text:last-child{color:#9a918a;font-size:19rpx}.record>text{font-weight:700;text-align:right}
