.profile-page { padding-bottom: 80rpx; }
.profile-card { display: flex; flex-direction: column; align-items: center; margin-top: 40rpx; text-align: center; }
.profile-logo { position: relative; overflow: hidden; width: 280rpx; height: 170rpx; margin-right: auto; margin-left: auto; background: #fff; }
.profile-logo image { position: absolute; top: -55rpx; left: 50%; width: 280rpx; transform: translateX(-50%); }
.name { margin: 24rpx 0 8rpx; font-size: 36rpx; font-weight: 700; }
.profile-card .muted { max-width: 520rpx; line-height: 1.6; }
.button-primary { width: 100%; }
.error-text { margin-top: 24rpx; color: #a43d2f; font-size: 26rpx; }
.state-card { margin-top: 40rpx; text-align: center; color: #81756d; }
.member-hero { display: flex; align-items: center; margin-top: 20rpx; }
.avatar { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; border-radius: 50%; background: #5a2d16; color: #fff; font-size: 40rpx; font-weight: 700; }
.member-copy { display: flex; flex: 1; flex-direction: column; margin-left: 24rpx; }
.member-copy .name { margin: 0 0 8rpx; }
.member-no { color: #81756d; font-size: 24rpx; }
.role-chip { padding: 10rpx 16rpx; border-radius: 999rpx; background: #efe4d8; color: #5a2d16; font-size: 22rpx; }
.section-card { margin-top: 24rpx; }
.section-title { display: block; margin-bottom: 26rpx; font-size: 30rpx; font-weight: 700; }
.field-label { display: block; margin-bottom: 12rpx; color: #81756d; font-size: 24rpx; }
.profile-input { box-sizing: border-box; width: 100%; height: 88rpx; padding: 0 24rpx; border: 2rpx solid #e9dfd5; border-radius: 16rpx; background: #fff; }
.save-button { margin-top: 24rpx; border-radius: 16rpx; background: #5a2d16; color: #fff; }
.menu-card { padding-top: 8rpx; padding-bottom: 8rpx; }
.menu-row { display: flex; justify-content: space-between; padding: 30rpx 0; border-bottom: 1rpx solid #eee5dc; }
.menu-row:last-child { border-bottom: 0; }
.menu-note { color: #9a8f87; }
.logout-button { margin-top: 30rpx; background: transparent; color: #81756d; font-size: 26rpx; }
.logout-button::after { border: 0; }
