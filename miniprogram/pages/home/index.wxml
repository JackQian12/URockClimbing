<view class="home-page" style="padding-top: {{safeTop}}px">
  <view class="home-header">
    <view class="brand-logo"><image src="/assets/logo.jpeg" mode="widthFix" /></view>
    <text class="greeting">{{greeting}}</text>
  </view>
  <view class="membership">
	<block wx:if="{{!isLoggedIn}}">
	  <text class="card-name">你的 URock 会员中心</text>
	  <text class="login-title">请先登录</text>
	  <text class="login-description">登录后可查看次卡余额、订单和核销记录</text>
	  <view class="redeem-button" role="button" aria-label="前往微信登录" bindtap="handleLogin">前往登录</view>
	</block>
	<block wx:else>
	  <text class="card-name">你的次卡</text>
	  <text class="empty-card-title">暂无可用次卡</text>
	  <text class="login-description">购买次卡后，剩余次数会显示在这里</text>
	  <button class="buy-link primary-buy-link" bindtap="handleBuyCard"><text>去选购次卡</text><image src="/assets/icons/chevron-right.png" /></button>
	</block>
  </view>
  <view class="section-heading">
    <text>本周岩馆动态</text>
    <view class="section-action" bindtap="handleGymNews"><text>查看全部</text><image src="/assets/icons/chevron-right.png" /></view>
  </view>
  <view class="news-card" bindtap="handleGymNews">
    <image src="/assets/climbing-community.jpg" mode="aspectFill" />
    <view class="news-copy"><text>新线路已开放 · V2–V5</text><image src="/assets/icons/chevron-right.png" /></view>
  </view>
</view>
