.state-card{display:flex;min-height:300rpx;align-items:center;justify-content:center}.error-text{color:#a1443c}.hero{padding:38rpx;border-radius:30rpx;color:#fff;background:linear-gradient(135deg,#59311e,#9e5330)}.hero-top{display:flex;align-items:center;justify-content:space-between}.hero-top text:first-child{font-size:35rpx;font-weight:800}.benefit{display:block;margin-top:48rpx;font-size:62rpx;font-weight:900}.card-no{display:block;margin-top:32rpx;color:rgba(255,255,255,.72);font-size:21rpx}.redeem-button{margin-top:26rpx;color:#fff!important;background:#542b15!important}.staff-redeem-button{margin-top:14rpx;border:2rpx solid #d8c9bf!important;color:#5a2d16!important;background:#fffdf9!important}.redeem-button::after,.staff-redeem-button::after{border:0}.info-card{display:flex;flex-direction:column;gap:24rpx;margin-top:26rpx}.info-card .title{font-size:30rpx;font-weight:800}.info-card view{display:flex;justify-content:space-between;color:#81756d;font-size:25rpx}.info-card view text:last-child{color:#3c2115}.records-title{margin:40rpx 4rpx 20rpx;font-size:31rpx;font-weight:800}.empty-record{text-align:center;color:#81756d}.record{display:flex;justify-content:space-between;padding:25rpx 0;border-bottom:1rpx solid #eee8df}.record view{display:flex;flex-direction:column;gap:8rpx}.record view text:last-child{color:#9a918a;font-size:19rpx}.record>text{font-weight:700}
