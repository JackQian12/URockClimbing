.orders-header { display: flex; flex-direction: column; gap: 10rpx; padding: 24rpx 4rpx 36rpx; }.orders-header text:first-child { font-size: 48rpx; font-weight: 800; }.orders-header text:last-child { color: #81756d; }
.state-card { display: flex; min-height: 280rpx; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; color: #81756d; text-align: center; }.empty-title { color: #3c2115; font-size: 32rpx; font-weight: 800; }.error-text { color: #a1443c; }
.order-list { display: flex; flex-direction: column; gap: 24rpx; }.order-card { display: flex; flex-direction: column; gap: 24rpx; }.order-top,.order-benefit,.order-meta { display: flex; align-items: center; justify-content: space-between; }.order-top>text:first-child { font-size: 31rpx; font-weight: 800; }.status { padding: 7rpx 14rpx; border-radius: 999rpx; color: #715b24; background: #f6e9bd; font-size: 21rpx; }.status-PAID { color: #275a3d; background: #dcecdf; }.status-CLOSED,.status-REFUNDED { color: #777; background: #eee; }.order-benefit { color: #756860; }.amount { color: #3c2115; font-size: 34rpx; font-weight: 800; }.order-meta { padding-top: 20rpx; border-top: 1rpx solid #eee8df; color: #958980; font-size: 22rpx; }
