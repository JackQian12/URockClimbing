<view class="home-page" style="padding-top: {{safeTop}}px">
  <view class="home-header">
    <view class="brand-logo"><image src="/assets/logo.jpeg" mode="widthFix" /></view>
    <text class="greeting">{{greeting}}</text>
  </view>
  <view class="membership">
    <text class="card-name">你的{{cardName}}</text>
    <view class="balance-line"><text>还可攀</text><text class="balance-number">{{remainingTimes}}</text><text>次</text></view>
    <view class="expiry"><text>有效期至</text><text>{{expiresAt}}</text></view>
    <view class="redeem-button" role="button" aria-label="生成核销码" bindtap="handleRedeem">生成核销码</view>
    <button class="buy-link" bindtap="handleBuyCard"><text>购买次卡</text><image src="/assets/icons/chevron-right.png" /></button>
  </view>
  <view class="section-heading">
    <text>本周岩馆动态</text>
    <view class="section-action" bindtap="handleGymNews"><text>查看全部</text><image src="/assets/icons/chevron-right.png" /></view>
  </view>
  <view class="news-card" bindtap="handleGymNews">
    <image src="/assets/climbing-community.jpg" mode="aspectFill" />
    <view class="news-copy"><text>新线路已开放 · V2–V5</text><image src="/assets/icons/chevron-right.png" /></view>
  </view>
  <view class="last-visit">
    <image class="clock-icon" src="/assets/icons/clock.png" />
    <text>上次到店</text><text class="visit-date">{{lastVisit}}</text><image class="visit-arrow" src="/assets/icons/chevron-right.png" />
  </view>
</view>
