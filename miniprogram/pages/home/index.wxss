.home-page { min-height: 100vh; padding-right: 56rpx; padding-bottom: 42rpx; padding-left: 56rpx; background: #faf7f1; box-sizing: border-box; }
.home-header { display: flex; height: 176rpx; align-items: center; justify-content: space-between; }
.brand-logo { position: relative; overflow: hidden; width: 236rpx; height: 126rpx; }
.brand-logo image { position: absolute; top: -54rpx; left: 0; width: 236rpx; mix-blend-mode: multiply; }
.greeting { margin-top: -8rpx; color: #4a2a1d; font-size: 28rpx; font-weight: 500; letter-spacing: 1rpx; }
.membership { padding-top: 30rpx; }
.card-name { display: block; color: #543121; font-size: 34rpx; font-weight: 500; letter-spacing: 1rpx; }
.balance-line { display: flex; align-items: baseline; gap: 18rpx; margin-top: 24rpx; color: #472719; font-size: 64rpx; font-weight: 700; line-height: 1.15; letter-spacing: -2rpx; }
.balance-number { color: #a94d2b; font-size: 116rpx; font-weight: 500; letter-spacing: -6rpx; }
.expiry { display: flex; gap: 30rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(92, 61, 44, .2); color: #604032; font-size: 27rpx; }
.expiry text:last-child { color: #ad4c2b; letter-spacing: 2rpx; }
.redeem-button { display: flex; width: 638rpx; max-width: 100%; height: 102rpx; align-items: center; justify-content: center; margin: 48rpx 0 0 !important; padding: 0; border: 0; border-radius: 20rpx; box-sizing: border-box; color: #fffaf5 !important; background: #542b15 !important; font-size: 31rpx; font-weight: 700; letter-spacing: 2rpx; line-height: 102rpx; box-shadow: 0 14rpx 28rpx rgba(72, 38, 20, .14); }
.redeem-button::after,.buy-link::after { border: 0; }
.buy-link { display: flex; width: 100%; height: 90rpx; align-items: center; justify-content: center; gap: 8rpx; margin: 0; padding: 0; border: 0; color: #4f2c1c !important; background: transparent !important; font-size: 28rpx; line-height: 90rpx; }
.buy-link image { width: 34rpx; height: 34rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin-top: 52rpx; margin-bottom: 24rpx; color: #4a291b; font-size: 32rpx; font-weight: 700; }
.section-action { display: flex; align-items: center; gap: 2rpx; color: #7b6b62; font-size: 24rpx; font-weight: 400; }.section-action image { width: 32rpx; height: 32rpx; opacity: .65; }
.news-card { overflow: hidden; border-radius: 24rpx; background: #fffdf9; box-shadow: 0 14rpx 34rpx rgba(71, 44, 28, .09); }
.news-card image { display: block; width: 100%; height: 330rpx; }
.news-copy { display: flex; height: 86rpx; align-items: center; justify-content: space-between; padding: 0 26rpx; color: #4d2a1b; font-size: 28rpx; font-weight: 600; }
.news-copy image { width: 38rpx; height: 38rpx; }
.last-visit { display: flex; height: 90rpx; align-items: center; margin-top: 24rpx; padding: 0 26rpx; border-radius: 22rpx; color: #5d4033; background: rgba(255, 253, 249, .88); box-shadow: 0 10rpx 28rpx rgba(71, 44, 28, .05); font-size: 25rpx; }
.clock-icon { width: 42rpx; height: 42rpx; margin-right: 18rpx; }
.visit-date { margin-left: 16rpx; color: #4b2a1c; font-weight: 600; }
.visit-arrow { width: 38rpx; height: 38rpx; margin-left: auto; }
