<view class="page"><view wx:if="{{loading}}" class="card state-card">正在加载…</view><view wx:elif="{{error}}" class="card state-card error-text">{{error}}</view><block wx:elif="{{card}}"><view class="hero"><view class="hero-top"><text>{{card.product_name}}</text><text>{{statusLabel}}</text></view><text class="benefit">{{benefit}}</text><text class="card-no">卡号 {{card.card_no}}</text></view><button wx:if="{{card.status==='ACTIVE'||card.status==='PENDING_ACTIVATION'}}" class="redeem-button" bindtap="handleCheckin">扫场馆码签到 / 核销</button><button wx:if="{{card.status==='ACTIVE'||card.status==='PENDING_ACTIVATION'}}" class="staff-redeem-button" bindtap="handleRedeem">出示给员工核销</button><view class="card info-card"><text class="title">权益信息</text><view><text>有效期至</text><text>{{expiryLabel}}</text></view><view><text>核销规则</text><text>{{card.product_type==='TIME_PASS'?'每日最多 1 次':'每次扣减 1 次'}}</text></view></view><view class="records-title">使用记录</view><view wx:if="{{records.length===0}}" class="card empty-record">暂无核销记录</view><view wx:else class="card record-list"><view wx:for="{{records}}" wx:key="redemption_no" class="record"><view><text>{{item.timeLabel}}</text><text>{{item.redemption_no}}</text></view><text>{{item.changeLabel}}</text></view></view></block></view>
