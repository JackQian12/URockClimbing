.checkin-page { padding-bottom: 70rpx; }.checkin-intro { padding: 54rpx 38rpx 40rpx; text-align: center; }.scan-symbol { display: grid; width: 122rpx; height: 122rpx; margin: 0 auto 32rpx; place-items: center; border-radius: 34rpx; color: #3c2115; background: #e4ef9a; font-size: 70rpx; }.intro-title,.intro-copy,.safety-note { display: block; }.intro-title { font-size: 40rpx; font-weight: 700; }.intro-copy { margin: 20rpx 0 4rpx; color: #81756d; font-size: 26rpx; line-height: 1.7; }.scan-button { margin-top: 42rpx; }.safety-note { margin-top: 22rpx; color: #a19891; font-size: 22rpx; }.venue-card { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 30rpx; }.venue-card text { color: #81756d; font-size: 24rpx; }.venue-card strong { font-size: 29rpx; }.choose-title { display: block; margin: 38rpx 4rpx 20rpx; font-size: 29rpx; font-weight: 700; }.card-list { display: grid; gap: 18rpx; }.select-card { position: relative; display: grid; grid-template-columns: 1fr auto 36rpx; gap: 20rpx; align-items: center; border: 3rpx solid transparent; box-shadow: 0 10rpx 30rpx rgba(72,43,27,.06); }.select-card.selected { border-color: #9aae46; background: #fbfff0; }.card-product,.card-number,.card-right text { display: block; }.card-product { font-size: 29rpx; font-weight: 700; }.card-number { margin-top: 8rpx; color: #a19891; font-size: 20rpx; }.card-right { text-align: right; }.card-right strong { color: #a94d2b; font-size: 28rpx; }.card-right text { margin-top: 7rpx; color: #81756d; font-size: 21rpx; }.radio-dot { display: grid; width: 32rpx; height: 32rpx; place-items: center; border: 3rpx solid #c9c5bd; border-radius: 50%; }.selected .radio-dot { border-color: #70802f; }.selected .radio-dot view { width: 18rpx; height: 18rpx; border-radius: 50%; background: #70802f; }.confirm-button { margin-top: 34rpx; }.rescan-button { margin-top: 12rpx; border: 0; color: #69412e; background: transparent; font-size: 26rpx; }.rescan-button::after { border: 0; }.error-banner { display: block; margin-top: 24rpx; padding: 20rpx; border-radius: 16rpx; color: #9c382e; background: #fae9e6; font-size: 24rpx; }.success-card { padding-top: 54rpx; text-align: center; }.success-icon { display: grid; width: 100rpx; height: 100rpx; margin: 0 auto 24rpx; place-items: center; border-radius: 50%; color: #fff; background: #71813c; font-size: 54rpx; }.success-title,.success-venue,.success-product,.success-benefit,.result-no { display: block; }.success-title { font-size: 42rpx; font-weight: 700; }.success-venue { margin-top: 14rpx; color: #81756d; font-size: 24rpx; }.success-product { margin-top: 34rpx; font-size: 30rpx; font-weight: 600; }.success-benefit { margin-top: 12rpx; color: #a94d2b; font-size: 34rpx; font-weight: 700; }.result-no { margin-top: 26rpx; color: #aaa19a; font-size: 19rpx; word-break: break-all; }
