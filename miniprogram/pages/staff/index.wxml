<view class="page"><view class="staff-hero"><text>员工核销工作台</text><text>扫描会员出示的一次性二维码</text><button bindtap="handleScan">扫码核销</button></view><view class="section-title"><text>今日我的核销</text><text>{{items.length}} 笔</text></view><view wx:if="{{loading}}" class="card state-card">正在加载…</view><view wx:elif="{{error}}" class="card state-card error-text">{{error}}</view><view wx:elif="{{items.length===0}}" class="card state-card">今日暂无核销</view><view wx:else class="card record-list"><view wx:for="{{items}}" wx:key="redemption_no" class="record"><view><text>{{item.product_name}}</text><text>{{item.timeLabel}} · {{item.redemption_no}}</text></view><text>{{item.changeLabel}}</text></view></view></view>
