<view class="home-page" style="padding-top: {{safeTop}}px">
  <view class="home-header">
    <view class="brand-logo"><image src="/assets/logo.jpeg" mode="widthFix" /></view>
    <text class="greeting">{{greeting}}</text>
  </view>
  <view class="membership">
	<block wx:if="{{!isLoggedIn}}">
	  <text class="card-name">你的 URock 会员中心</text>
	  <text class="login-title">请先登录</text>
	  <text class="login-description">登录后可查看次卡余额、订单和核销记录</text>
	  <view class="redeem-button" role="button" aria-label="前往微信登录" bindtap="handleLogin">前往登录</view>
	</block>
	<block wx:elif="{{!isRegistered}}">
	  <text class="card-name">URock 会员注册</text>
	  <text class="login-title">请授权手机号</text>
	  <text class="login-description">授权成功即完成会员注册</text>
	  <view class="redeem-button" role="button" aria-label="前往手机号授权" bindtap="handleLogin">去完成注册</view>
	</block>
	<block wx:else>
	  <view class="welcome-line" wx:if="{{nickname}}">欢迎回来，{{nickname}}</view>
	  <block wx:if="{{primaryCard}}">
	    <text class="card-name">{{primaryCard.product_name}}</text>
	    <view class="balance-line"><text class="balance-number">{{cardBenefit}}</text></view>
	    <view class="expiry"><text>{{primaryCard.status === 'PENDING_ACTIVATION' ? '待激活' : '可使用'}}</text><text>{{cardMeta}}</text></view>
	    <view class="redeem-button" role="button" bindtap="handleRedeem">查看会员卡</view>
	    <button class="buy-link" bindtap="handleMyCards"><text>全部会员卡</text><image src="/assets/icons/chevron-right.png" /></button>
	  </block>
	  <block wx:else>
	    <text class="card-name">你的会员卡</text>
	    <text class="empty-card-title">暂无可用会员卡</text>
	    <text class="login-description">购卡后，次数或有效期权益会显示在这里</text>
	    <button class="buy-link primary-buy-link" bindtap="handleBuyCard"><text>去选购会员卡</text><image src="/assets/icons/chevron-right.png" /></button>
	  </block>
	  <view class="checkin-entry" role="button" bindtap="handleCheckin"><view class="checkin-entry-icon">▦</view><view><text>扫码签到 / 核销</text><text>扫描场馆签到码，选择会员卡</text></view><image src="/assets/icons/chevron-right.png" /></view>
	</block>
  </view>
  <view class="section-heading">
    <text>本周岩馆动态</text>
    <view class="section-action" bindtap="handleGymNews"><text>查看全部</text><image src="/assets/icons/chevron-right.png" /></view>
  </view>
  <view class="news-card" bindtap="handleGymNews">
    <image src="/assets/climbing-community.jpg" mode="aspectFill" />
    <view class="news-copy"><text>新线路已开放 · V2–V5</text><image src="/assets/icons/chevron-right.png" /></view>
  </view>
</view>
