.code-page{padding-top:48rpx}.code-header{display:flex;flex-direction:column;align-items:center;gap:12rpx;text-align:center}.code-header text:first-child{font-size:38rpx;font-weight:800}.code-header text:last-child{color:#81756d;font-size:24rpx}.code-card{display:flex;min-height:650rpx;flex-direction:column;align-items:center;justify-content:center;margin-top:38rpx}.state{display:flex;flex-direction:column;align-items:center;gap:24rpx;color:#81756d}.error-text{color:#a1443c}.qrcode{width:240px;height:240px}.countdown,.expired{margin-top:30rpx;font-size:34rpx;font-weight:800}.countdown{color:#8a3f20}.expired{color:#a1443c}.expires-label{margin-top:10rpx;color:#81756d;font-size:22rpx}.refresh-button{width:100%;margin-top:30rpx;border:1rpx solid #d6c8bd;border-radius:16rpx;color:#542b15;background:#fff}.notice{display:flex;flex-direction:column;gap:10rpx;margin-top:26rpx;padding:24rpx;border-radius:18rpx;color:#7a6458;background:#f1e8e0;font-size:23rpx;line-height:1.6}.notice text:first-child{color:#542b15;font-weight:700}
