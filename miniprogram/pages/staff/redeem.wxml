<view class="page"><view wx:if="{{loading}}" class="card state-card">正在校验核销码…</view><view wx:elif="{{error && !preview}}" class="card state-card"><text class="error-text">{{error}}</text><button bindtap="handleBack">返回重新扫码</button></view><view wx:elif="{{result}}" class="success-card card"><view class="success-icon">✓</view><text class="success-title">核销成功</text><text>{{result.product_name}}</text><text wx:if="{{result.after_remaining !== null}}">剩余 {{result.after_remaining}} 次</text><text wx:else>本日使用已记录</text><text class="result-no">{{result.redemption_no}}</text><button bindtap="handleBack">完成</button></view><block wx:elif="{{preview}}"><view class="preview-card card"><view class="member"><view class="avatar">{{memberInitial}}</view><view><text>{{preview.nickname || '岩友'}}</text><text>{{preview.member_no}} · 手机尾号 {{preview.phone_last4 || '—'}}</text></view></view><view class="divider"></view><view class="line"><text>会员卡</text><text>{{preview.product_name}}</text></view><view class="line"><text>当前权益</text><text class="benefit">{{benefit}}</text></view><view class="line"><text>有效期</text><text>{{expiry}}</text></view><view class="line"><text>卡号</text><text>{{preview.card_no}}</text></view></view><view wx:if="{{error}}" class="error-banner">{{error}}</view><button class="confirm-button" loading="{{confirming}}" disabled="{{confirming}}" bindtap="handleConfirm">确认核销</button><text class="warning">请核对会员和会员卡信息，核销成功后不可撤销</text></block></view>
