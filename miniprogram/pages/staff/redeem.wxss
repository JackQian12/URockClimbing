.state-card{display:flex;min-height:320rpx;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;text-align:center}.error-text{color:#a1443c}.preview-card{display:flex;flex-direction:column;gap:24rpx}.member{display:flex;align-items:center;gap:22rpx}.avatar{display:flex;width:88rpx;height:88rpx;align-items:center;justify-content:center;border-radius:50%;color:#fff;background:#7d4326;font-size:34rpx;font-weight:800}.member view:last-child{display:flex;flex-direction:column;gap:8rpx}.member view:last-child text:first-child{font-size:32rpx;font-weight:800}.member view:last-child text:last-child{color:#81756d;font-size:22rpx}.divider{height:1rpx;background:#eee8df}.line{display:flex;justify-content:space-between;gap:24rpx;color:#81756d;font-size:25rpx}.line text:last-child{color:#3c2115;text-align:right}.line .benefit{color:#9a4526;font-size:30rpx;font-weight:800}.confirm-button{margin-top:30rpx;color:#fff!important;background:#8a3f20!important;font-weight:800}.warning{display:block;margin-top:18rpx;color:#a16b4f;font-size:22rpx;text-align:center}.error-banner{margin-top:20rpx;padding:22rpx;border-radius:16rpx;color:#a1443c;background:#f9e8e5}.success-card{display:flex;min-height:580rpx;flex-direction:column;align-items:center;justify-content:center;gap:16rpx;text-align:center}.success-icon{display:flex;width:110rpx;height:110rpx;align-items:center;justify-content:center;border-radius:50%;color:#fff;background:#668354;font-size:58rpx}.success-title{font-size:42rpx;font-weight:800}.result-no{margin-top:12rpx;color:#9a918a;font-size:20rpx}.success-card button{width:100%;margin-top:30rpx;color:#fff;background:#542b15}
