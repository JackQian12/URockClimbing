.page-header{display:flex;flex-direction:column;gap:10rpx;padding:24rpx 4rpx 34rpx}.page-header text:first-child{font-size:48rpx;font-weight:800}.page-header text:last-child{color:#81756d;font-size:25rpx}.state-card{display:flex;min-height:300rpx;flex-direction:column;align-items:center;justify-content:center;gap:16rpx;text-align:center}.empty-title{font-size:32rpx;font-weight:700}.error-text{color:#a1443c}.card-list{display:flex;flex-direction:column;gap:26rpx}.member-card{padding:34rpx;border-radius:28rpx;color:#fff;background:linear-gradient(135deg,#59311e,#8d4a2c);box-shadow:0 18rpx 42rpx rgba(67,35,19,.2)}.member-card.status-USED_UP,.member-card.status-EXPIRED,.member-card.status-REFUNDED{background:linear-gradient(135deg,#77736e,#aaa39b)}.member-card.status-REFUND_LOCKED{background:linear-gradient(135deg,#725c39,#aa8c54)}.card-top,.card-bottom{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.card-name{font-size:34rpx;font-weight:800}.status-chip{padding:7rpx 14rpx;border-radius:999rpx;background:rgba(255,255,255,.18);font-size:21rpx}.benefit{display:block;margin-top:38rpx;font-size:48rpx;font-weight:800}.expiry{display:block;margin-top:12rpx;color:rgba(255,255,255,.8);font-size:23rpx}.card-bottom{margin-top:38rpx;padding-top:22rpx;border-top:1rpx solid rgba(255,255,255,.22);font-size:21rpx}.button-primary{min-width:240rpx}
