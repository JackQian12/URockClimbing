<view class="page"><view class="page-header"><text>核销记录</text></view><view wx:if="{{loading}}" class="card state-card">正在加载…</view><view wx:elif="{{error}}" class="card state-card error-text">{{error}}</view><view wx:elif="{{items.length===0}}" class="card state-card">暂无核销记录</view><view wx:else class="card record-list"><view wx:for="{{items}}" wx:key="redemption_no" class="record"><view><text>{{item.product_name}}</text><text>{{item.timeLabel}}</text></view><text>{{item.changeLabel}}</text></view></view></view>
